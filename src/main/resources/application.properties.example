spring.application.name=Smart IT Asset Intelligence

# MySQL Database configuration
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/it_asset_intelligence?serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false}
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:yourpassword}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA/Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
